        <dc:Bounds x="1640" y="220" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Payment" bpmnElement="Payment">
        <dc:Bounds x="1950" y="1225" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Construction" bpmnElement="Construction">
        <dc:Bounds x="2120" y="510" width="36" height="50" />
      </bpmndi:BPMNShape>
