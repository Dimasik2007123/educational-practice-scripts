        <dc:Bounds x="60" y="40" width="3320" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Company" bpmnElement="Company" isHorizontal="true">
        <dc:Bounds x="60" y="180" width="3320" height="1160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Bank" bpmnElement="Bank" isHorizontal="true">
        <dc:Bounds x="60" y="1400" width="3320" height="100" />
      </bpmndi:BPMNShape>
