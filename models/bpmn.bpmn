<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Sale" targetNamespace="https://example.test/practice/sale" exporter="Educational practice KT2">
  <bpmn:collaboration id="Collaboration_Sale">
    <bpmn:participant id="Client" name="Клиент" />
    <bpmn:participant id="Company" name="Компания-застройщик" processRef="Process_Sale" />
    <bpmn:participant id="Bank" name="Банк" />
    <bpmn:messageFlow id="Message_1" sourceRef="Client" targetRef="Start" name="Обращение" />
    <bpmn:messageFlow id="Message_2" sourceRef="Select" targetRef="Client" name="Выбор объекта" />
    <bpmn:messageFlow id="Message_3" sourceRef="Contract" targetRef="Client" name="Договор" />
    <bpmn:messageFlow id="Message_4" sourceRef="Client" targetRef="SignedContract" name="Подписанный договор" />
    <bpmn:messageFlow id="Message_5" sourceRef="Client" targetRef="Bank" name="Оплата" />
    <bpmn:messageFlow id="Message_6" sourceRef="Bank" targetRef="Paid" name="Подтверждение поступления" />
    <bpmn:messageFlow id="Message_7" sourceRef="Act" targetRef="Client" name="Акт" />
    <bpmn:messageFlow id="Message_8" sourceRef="Client" targetRef="SignedAct" name="Подписанный акт" />
    <bpmn:messageFlow id="Message_9" sourceRef="Key" targetRef="Client" name="Код постамата" />
    <bpmn:messageFlow id="Message_10" sourceRef="Client" targetRef="Transfer" name="Подтверждение получения" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Sale" name="Оформление и сопровождение сделки до передачи покупателю" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Sale">
      <bpmn:lane id="Lane_Manager" name="Менеджер по продажам">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Booked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignedContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Readiness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignedAct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Key</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Accountant" name="Бухгалтер">
        <bpmn:flowNodeRef>Paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Получено обращение клиента">
      <bpmn:messageEventDefinition id="MessageDef_Start" />
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Receive" name="Принять требования клиента">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Search" name="Подобрать объекты по требованиям клиента">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Found" name="Объект найден?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Select" name="Согласовать выбранный объект">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Book" name="Забронировать объект">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Booked" name="Бронь создана?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Contract" name="Подготовить договор">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="SignedContract" name="Договор подписан">
      <bpmn:messageEventDefinition id="MessageDef_SignedContract" />
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Sale" name="Оформить сделку">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Paid" name="Получено подтверждение банка">
      <bpmn:messageEventDefinition id="MessageDef_Paid" />
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="ConfirmPayment" name="Подтвердить оплату">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Readiness" name="Проверить готовность объекта">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Ready" name="Объект готов?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Wait" name="Ожидать готовности">
      <bpmn:timerEventDefinition id="Timer_Wait">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Act" name="Оформить акт приема-передачи">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="SignedAct" name="Акт подписан">
      <bpmn:messageEventDefinition id="MessageDef_SignedAct" />
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Key" name="Сформировать код для получения ключей">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Transfer" name="Передать объект и подтвердить получение ключей">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Fork" name="">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Close" name="Зафиксировать закрытие сделки">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Report" name="Сформировать отчёт по продажам">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Join" name="">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End" name="Объект передан, сделка закрыта">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="NotFound" name="Нет подходящего объекта">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Rejected" name="Бронирование отклонено">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Receive" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Receive" targetRef="Search" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Search" targetRef="Found" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Found" targetRef="Select" name="да" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Found" targetRef="NotFound" name="нет" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Select" targetRef="Book" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Book" targetRef="Booked" name="" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Booked" targetRef="Contract" name="да" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Booked" targetRef="Rejected" name="нет" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Contract" targetRef="SignedContract" name="" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="SignedContract" targetRef="Sale" name="" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Sale" targetRef="Paid" name="" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Paid" targetRef="ConfirmPayment" name="" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="ConfirmPayment" targetRef="Readiness" name="" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Readiness" targetRef="Ready" name="" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Ready" targetRef="Act" name="да" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Ready" targetRef="Wait" name="нет" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Wait" targetRef="Readiness" name="" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Act" targetRef="SignedAct" name="" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="SignedAct" targetRef="Key" name="" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Key" targetRef="Transfer" name="" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Transfer" targetRef="Fork" name="" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Fork" targetRef="Close" name="" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Fork" targetRef="Report" name="" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Close" targetRef="Join" name="" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Report" targetRef="Join" name="" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Join" targetRef="End" name="" />
    <bpmn:dataObject id="Data_Request" />
    <bpmn:dataObjectReference id="Request" dataObjectRef="Data_Request" name="Сведения клиента и требования" />
    <bpmn:association id="Association_Request" sourceRef="Request" targetRef="Receive" associationDirection="One" />
    <bpmn:dataObject id="Data_Catalog" />
    <bpmn:dataObjectReference id="Catalog" dataObjectRef="Data_Catalog" name="Карточки объектов; тип и статус" />
    <bpmn:association id="Association_Catalog" sourceRef="Catalog" targetRef="Search" associationDirection="One" />
    <bpmn:dataObject id="Data_Bookings" />
    <bpmn:dataObjectReference id="Bookings" dataObjectRef="Data_Bookings" name="История бронирований" />
    <bpmn:association id="Association_Bookings" sourceRef="Bookings" targetRef="Book" associationDirection="One" />
    <bpmn:dataObject id="Data_Staff" />
    <bpmn:dataObjectReference id="Staff" dataObjectRef="Data_Staff" name="Сотрудник и должность" />
    <bpmn:association id="Association_Staff" sourceRef="Staff" targetRef="Receive" associationDirection="One" />
    <bpmn:dataObject id="Data_ContractData" />
    <bpmn:dataObjectReference id="ContractData" dataObjectRef="Data_ContractData" name="Договор и тип договора" />
    <bpmn:association id="Association_ContractData" sourceRef="ContractData" targetRef="Contract" associationDirection="One" />
    <bpmn:dataObject id="Data_SaleData" />
    <bpmn:dataObjectReference id="SaleData" dataObjectRef="Data_SaleData" name="Сделка и позиции сделки" />
    <bpmn:association id="Association_SaleData" sourceRef="SaleData" targetRef="Sale" associationDirection="One" />
    <bpmn:dataObject id="Data_Payment" />
    <bpmn:dataObjectReference id="Payment" dataObjectRef="Data_Payment" name="Подтверждение оплаты" />
    <bpmn:association id="Association_Payment" sourceRef="Payment" targetRef="ConfirmPayment" associationDirection="One" />
    <bpmn:dataObject id="Data_Construction" />
    <bpmn:dataObjectReference id="Construction" dataObjectRef="Data_Construction" name="Статус строительной готовности" />
    <bpmn:association id="Association_Construction" sourceRef="Construction" targetRef="Readiness" associationDirection="One" />
    <bpmn:dataObject id="Data_Certificate" />
    <bpmn:dataObjectReference id="Certificate" dataObjectRef="Data_Certificate" name="Акт и позиции акта" />
    <bpmn:association id="Association_Certificate" sourceRef="Certificate" targetRef="Act" associationDirection="One" />
    <bpmn:dataObject id="Data_Keys" />
    <bpmn:dataObjectReference id="Keys" dataObjectRef="Data_Keys" name="Комплект ключей; тип; код" />
    <bpmn:association id="Association_Keys" sourceRef="Keys" targetRef="Key" associationDirection="One" />
    <bpmn:dataObject id="Data_Registry" />
    <bpmn:dataObjectReference id="Registry" dataObjectRef="Data_Registry" name="Реестр сделок за период" />
    <bpmn:association id="Association_Registry" sourceRef="Registry" targetRef="Report" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Sale">
    <bpmndi:BPMNPlane id="Plane_Sale" bpmnElement="Collaboration_Sale">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="150" y="390" width="36" height="36" />
      </bpmndi:BPMNShape>
