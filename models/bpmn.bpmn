        <dc:Bounds x="245" y="220" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Catalog" bpmnElement="Catalog">
        <dc:Bounds x="490" y="220" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Bookings" bpmnElement="Bookings">
        <dc:Bounds x="1010" y="220" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Staff" bpmnElement="Staff">
        <dc:Bounds x="330" y="650" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ContractData" bpmnElement="ContractData">
        <dc:Bounds x="1310" y="220" width="36" height="50" />
      </bpmndi:BPMNShape>
